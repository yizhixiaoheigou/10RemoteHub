<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- PyInstaller signs with the hardened runtime. A self-made certificate has
	     no TeamIdentifier, so dyld's library validation rejects the bundled
	     libpython and Qt binaries even though they carry the same certificate.
	     Apple-issued certificates do not need this exemption. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
